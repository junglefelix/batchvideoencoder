<?xml version="1.0"?>
<configuration>
<configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <section name="BatchVideoEncoder.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
</configSections>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup><userSettings>
        <BatchVideoEncoder.Settings>
            <setting name="NeroAaacDefaultQuality" serializeAs="String">
                <value>0.24</value>
            </setting>
            <setting name="X265DefaultCrf" serializeAs="String">
                <value>32</value>
            </setting>
            <setting name="defaultVideoPreset" serializeAs="String">
                <value>medium</value>
            </setting>
            <setting name="X265Presets" serializeAs="String">
                <value>ultrafast,superfast,veryfast,faster,fast,medium,slow,slower,veryslow</value>
            </setting>
            <setting name="SupportedFileExtensions" serializeAs="String">
                <value>.avi,.flv,.mp4,.mkv,.mpg,.vob,.wmv,.webm</value>
            </setting>
            <setting name="OutFileSuffix" serializeAs="String">
                <value>_</value>
            </setting>
            <setting name="xResLimit" serializeAs="String">
                <value>720</value>
            </setting>
            <setting name="yResLimit" serializeAs="String">
                <value>480</value>
            </setting>
            <setting name="OutputDirectory" serializeAs="String">
                <value />
            </setting>
            <setting name="NoiseFilters" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <string>No Filter, </string>
                        <string>Light Denoise Filter,hqdn3d=2.0:1.0:2.0:3.0</string>
                        <string>Medium Denoise Filter,hqdn3d=4.0:3.0:6.0:4.5</string>
                        <string>Strong Denoise Filter,hqdn3d=7.0:7.0:5.0:5.0</string>
                    </ArrayOfString>
                </value>
            </setting>
        </BatchVideoEncoder.Settings>
    </userSettings>
</configuration>
